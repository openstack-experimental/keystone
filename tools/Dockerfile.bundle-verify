################
##### Verify-and-pin image for the OPA policy bundle (Gate H, load side).
##### Runs tools/verify_and_pin_opa_bundle.sh in an init container: resolve the
##### bundle tag to a digest, `cosign verify` it against this repository's
##### GitHub Actions identity, and write an OPA config pinned to that digest.
##### Built for linux/amd64 and linux/arm64. The tools are fetched on the build
##### platform and copied in, so no target-platform code runs during the build.
FROM --platform=$BUILDPLATFORM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS fetch

ARG TARGETARCH
ARG COSIGN_VERSION=3.1.4
ARG COSIGN_SHA256_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
ARG COSIGN_SHA256_ARM64=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
ARG ORAS_VERSION=1.3.6
ARG ORAS_SHA256_AMD64=66fb0ad7206f3f6fa77ed5b552049d364ccf4b50b1684554f731f76302b52ca0
ARG ORAS_SHA256_ARM64=b84269e78dfc2d5329a4aab373da3200de95e6c138338cf6c66c10c0a3f248c1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl && \
    case "${TARGETARCH}" in \
      amd64) COSIGN_SHA256="${COSIGN_SHA256_AMD64}"; ORAS_SHA256="${ORAS_SHA256_AMD64}" ;; \
      arm64) COSIGN_SHA256="${COSIGN_SHA256_ARM64}"; ORAS_SHA256="${ORAS_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    mkdir /out && \
    curl -fsSL -o /out/cosign \
      "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${TARGETARCH}" && \
    echo "${COSIGN_SHA256}  /out/cosign" | sha256sum -c - && \
    chmod 755 /out/cosign && \
    curl -fsSL -o /tmp/oras.tgz \
      "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" && \
    echo "${ORAS_SHA256}  /tmp/oras.tgz" | sha256sum -c - && \
    tar -xzf /tmp/oras.tgz -C /out oras

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

LABEL maintainer="Artem Goncharov"

COPY --from=fetch /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=fetch /out/cosign /out/oras /usr/local/bin/
COPY tools/verify_and_pin_opa_bundle.sh /usr/local/bin/verify_and_pin_opa_bundle.sh
COPY tools/opa_config.yaml /usr/share/keystone/opa_config.yaml

# Numeric ids only: no user database entry is needed, and creating one would
# run a target-platform command during a cross-platform build.
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/verify_and_pin_opa_bundle.sh"]
