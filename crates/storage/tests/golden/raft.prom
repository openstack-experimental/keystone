# HELP keystone_raft_apply_lag Log entries by which this node's last applied index trails the cluster commit index reported by the leader.
# TYPE keystone_raft_apply_lag gauge
keystone_raft_apply_lag 0
# HELP keystone_raft_current_leader_id Raft node id of the leader as seen by this node (-1 when unknown).
# TYPE keystone_raft_current_leader_id gauge
keystone_raft_current_leader_id 1
