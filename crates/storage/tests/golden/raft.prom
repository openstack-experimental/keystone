# TYPE keystone_raft_dek_reencrypt_migrated_total counter
keystone_raft_dek_reencrypt_migrated_total 0
# HELP keystone_raft_dek_reencrypt_skipped_total Records skipped by background DEK re-encryption sweeps.
# TYPE keystone_raft_dek_reencrypt_skipped_total counter
keystone_raft_dek_reencrypt_skipped_total 0
# HELP keystone_raft_gcm_failures_total AES-GCM tag verification failures on state reads.
# TYPE keystone_raft_gcm_failures_total counter
keystone_raft_gcm_failures_total 0
# HELP keystone_raft_is_leader Whether this node is the current Raft leader (1) or not (0).
# TYPE keystone_raft_is_leader gauge
keystone_raft_is_leader 1
# HELP keystone_raft_last_applied_index Last Raft log index applied to this node's state machine.
# TYPE keystone_raft_last_applied_index gauge
keystone_raft_last_applied_index 95
# HELP keystone_raft_last_log_index Last Raft log index appended to this node's log (tail position).
# TYPE keystone_raft_last_log_index gauge
keystone_raft_last_log_index 100
