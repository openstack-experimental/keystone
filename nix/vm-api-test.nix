# NixOS VM test: the `test_api` live-server suite, hermetic.
#
# Replaces `tools/start-api.sh` + `tools/start-spire.sh` for the Nix path:
# SPIRE server and agent, a regorus-policy keystone (no OPA daemon) and the
# bootstrap run as systemd units, then the pre-built `test_api` nextest
# archive runs against them. Keep the generated keystone.conf in sync with
# `tools/start-api.sh` (checked by `tools/check-nix-config-sync.sh`).
{
  pkgs,
  keystone,
  referencePlugin,
  apiArchive,
  src,
}:
let
  trustDomain = "example.org";
  stateDir = "/var/lib/keystone-test";
  kek = "4242424242424242424242424242424242424242424242424242424242424242";
  agentSocket = "/run/spire/agent.sock";
  serverSocket = "/run/spire/server.sock";
  fixtures = "${src}/tests/api/fixtures/oauth2";

  spireServerConf = pkgs.writeText "spire-server.conf" ''
    server {
        bind_address = "127.0.0.1"
        bind_port = "13081"
        trust_domain = "${trustDomain}"
        data_dir = "/var/lib/spire"
        log_level = "WARN"
        socket_path = "${serverSocket}"
    }
    plugins {
        DataStore "sql" {
            plugin_data {
                database_type = "sqlite3"
                connection_string = "/var/lib/spire/datastore.sqlite3"
            }
        }
        KeyManager "disk" {
            plugin_data { keys_path = "/var/lib/spire/keys.json" }
        }
        NodeAttestor "join_token" { plugin_data {} }
    }
  '';

  spireAgentConf = pkgs.writeText "spire-agent.conf" ''
    agent {
        data_dir = "/var/lib/spire-agent"
        log_level = "WARN"
        server_address = "127.0.0.1"
        server_port = "13081"
        socket_path = "${agentSocket}"
        trust_domain = "${trustDomain}"
        insecure_bootstrap = true
    }
    plugins {
        KeyManager "memory" { plugin_data {} }
        NodeAttestor "join_token" { plugin_data {} }
        WorkloadAttestor "unix" { plugin_data {} }
    }
  '';

  # Written at service start: needs the plugin sha256 and per-run TLS certs.
  # Both are generated by the unit's pre-start script below.
  keystoneConfTemplate = pkgs.writeText "keystone.conf.in" ''
    [api_policy]
    engine = regorus
    regorus_policies_path = ${src}/policy

    [rate_limit_global_ip]
    enabled = false

    [rate_limit_user_auth]
    enabled = false

    [auth]
    methods = password,token,openid,application_credential,x509,mapped,hacked_appcred_handler,ec2credential

    [DEFAULT]
    use_stderr = false
    debug = true
    log_dir = ${stateDir}
    public_endpoint = http://localhost:8080

    [oauth2]
    allow_host_header_issuer = true
    refresh_token_reuse_grace_minutes = 0
    templates_dir = ${fixtures}/templates
    static_dir = ${fixtures}/static
    ui_product_name = Fixture Cloud
    ui_logo_url = /v4/oauth2/static/logo.svg

    [token]
    provider = fernet

    [database]
    connection = sqlite::memory:

    [fernet_receipts]
    key_repository = ${stateDir}/etc/fernet-keys
    [fernet_tokens]
    key_repository = ${stateDir}/etc/fernet-keys

    [interface_public]
    tcp_address = 0.0.0.0:8080
    type = "http"

    [interface_internal]
    tcp_address = 127.0.0.1:8215
    type = "spiffe"
    trust_domains = ${trustDomain}

    [interface_admin]
    socket_path = ${stateDir}/keystone.sock
    trust_domains=${trustDomain}
    admin_svid=spiffe://${trustDomain}/keystone

    [distributed_storage]
    path = ${stateDir}/raft/db
    node_cluster_addr = https://127.0.0.1:50051
    node_listener_addr = 0.0.0.0:50051
    node_id = 0
    tls_client_ca_file = ${stateDir}/ca.crt
    tls_cert_file = ${stateDir}/ks.pem
    tls_key_file = ${stateDir}/ks.key
    dev_mode = true

    [credential]
    key_repository = ${stateDir}/etc/fernet-keys

    [webauthn]
    driver = raft
    enabled = true
    relying_party_id = localhost
    relying_party_origin = http://localhost:8080

    [mapping]
    cluster_salt = "fbb27433d07ab307cc1fc899d0e174cf197fd398fbcff7285a63fe2f94eec2fe"

    [audit]
    spool_dir = ${stateDir}/audit
    node_id = api-test-node

    [auth_plugins]
    plugins = mapper,router,hacked_appcred_handler

    [auth_plugin.mapper]
    path = ${referencePlugin}/reference_plugin.wasm
    sha256 = @PLUGIN_SHA256@
    mode = mapping
    invocation_rate_limit_per_source_per_minute = 100000
    invocation_rate_limit_per_minute = 100000

    [auth_plugin.router]
    path = ${referencePlugin}/reference_plugin.wasm
    sha256 = @PLUGIN_SHA256@
    mode = route
    inspect_methods = application_credential
    route_targets = hacked_appcred_handler
    invocation_rate_limit_per_source_per_minute = 100000
    invocation_rate_limit_per_minute = 100000

    [auth_plugin.hacked_appcred_handler]
    path = ${referencePlugin}/reference_plugin.wasm
    sha256 = @PLUGIN_SHA256@
    mode = full_auth
    capabilities = provision_user
    provision_domain_id = d
    timeout_ms = 5000
    invocation_rate_limit_per_source_per_minute = 100000
    invocation_rate_limit_per_minute = 100000
  '';

  prepareKeystone = pkgs.writeShellScript "keystone-prepare" ''
    set -euo pipefail
    export PATH=${
      pkgs.lib.makeBinPath [
        pkgs.openssl
        pkgs.coreutils
        pkgs.gnused
      ]
    }
    d=${stateDir}
    rm -rf "$d"
    mkdir -p "$d/etc/fernet-keys" "$d/audit"
    echo "2Rlc-npWYOGqqG1zM-bmfBj2apLacLXhIbBsdyqQ0zg=" > "$d/etc/fernet-keys/0"

    # Self-signed CA + leaf for distributed storage.
    openssl req -x509 -newkey rsa:2048 -nodes -keyout "$d/ca.key" \
      -out "$d/ca.crt" -subj "/CN=Keystone-CA" -days 30 2>/dev/null
    openssl req -newkey rsa:2048 -nodes -keyout "$d/ks.key" \
      -out "$d/ks.csr" -subj "/CN=127.0.0.1" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" 2>/dev/null
    openssl x509 -req -in "$d/ks.csr" -CA "$d/ca.crt" -CAkey "$d/ca.key" \
      -CAcreateserial -out "$d/ks.pem" -days 30 -copy_extensions copyall 2>/dev/null

    sha=$(sha256sum ${referencePlugin}/reference_plugin.wasm | cut -d' ' -f1)
    sed "s/@PLUGIN_SHA256@/$sha/g" ${keystoneConfTemplate} > "$d/keystone.conf"
  '';

  keystoneEnv = {
    KEYSTONE_DEV_KEK = kek;
    KEYSTONE_ALLOW_ENV_KEK = "1";
    SPIFFE_ENDPOINT_SOCKET = "unix://${agentSocket}";
  };

  bootstrap = pkgs.writeShellScript "keystone-bootstrap" ''
    set -euo pipefail
    export PATH=${
      pkgs.lib.makeBinPath [
        pkgs.curl
        pkgs.coreutils
        pkgs.gnugrep
      ]
    }
    ready=0
    for _ in $(seq 1 300); do
      if curl -sf http://127.0.0.1:8099/health >/dev/null; then
        ready=1
        break
      fi
      sleep 0.2
    done
    if [ "$ready" -ne 1 ]; then
      echo "keystone health endpoint never answered" >&2
      exit 1
    fi
    ready=0
    for _ in $(seq 1 120); do
      if [ -S ${stateDir}/keystone.sock ]; then
        ready=1
        break
      fi
      sleep 0.5
    done
    if [ "$ready" -ne 1 ]; then
      echo "keystone admin socket ${stateDir}/keystone.sock never appeared" >&2
      exit 1
    fi
    ${keystone}/bin/keystone-manage --config ${stateDir}/keystone.conf bootstrap \
      --bootstrap-password password \
      --bootstrap-public-url http://localhost:8080
    # The default domain's OAuth2 keys are provisioned asynchronously.
    for _ in $(seq 1 60); do
      n=$(curl -s http://127.0.0.1:8080/v4/oauth2/default/jwks | grep -c '"kty"' || true)
      [ "$n" -gt 0 ] && exit 0
      sleep 0.5
    done
    echo "OAuth2 default-domain keys never appeared" >&2
    exit 1
  '';

  runTests = pkgs.writeShellScriptBin "run-api-tests" ''
    set -euo pipefail
    export PATH=${
      pkgs.lib.makeBinPath [
        pkgs.cargo-nextest
        pkgs.coreutils
      ]
    }
    mkdir -p /root/client-home /root/client-config
    printf 'cache:\n  auth: false\n' > /root/client-config/clouds.yaml
    export KEYSTONE_URL=http://localhost:8080
    export OS_AUTH_URL=http://localhost:8080
    export WEBAUTHN_URL=http://localhost:8080
    export OS_USERNAME=admin OS_PASSWORD=password
    export OS_USER_DOMAIN_ID=default OS_PROJECT_NAME=admin OS_PROJECT_DOMAIN_ID=default
    export HOME=/root/client-home
    export OS_CLIENT_CONFIG_PATH=/root/client-config/clouds.yaml
    export KEYSTONE_DEV_KEK=${kek} KEYSTONE_ALLOW_ENV_KEK=1
    export SPIFFE_ENDPOINT_SOCKET=unix://${agentSocket}
    export AUDIT_SPOOL_DIR=${stateDir}/audit
    cd ${src}
    exec cargo-nextest nextest run \
      --archive-file ${apiArchive}/archive.tar.zst \
      --workspace-remap ${src} \
      -E 'binary(integration_api_v3) + binary(integration_api_v4) + binary(scim_v2)' \
      "$@"
  '';
in
pkgs.testers.runNixOSTest {
  name = "keystone-api";

  nodes.machine =
    { ... }:
    {
      virtualisation = {
        memorySize = 4096;
        cores = 4;
        diskSize = 4096;
      };

      environment.systemPackages = [
        runTests
        pkgs.spire
        pkgs.curl
      ];

      systemd.services.spire-server = {
        wantedBy = [ "multi-user.target" ];
        path = [ pkgs.spire ];
        serviceConfig = {
          RuntimeDirectory = "spire";
          RuntimeDirectoryPreserve = true;
          StateDirectory = "spire";
          ExecStart = "${pkgs.spire}/bin/spire-server run -config ${spireServerConf}";
          ExecStartPost = pkgs.writeShellScript "spire-server-ready" ''
            until ${pkgs.spire}/bin/spire-server healthcheck -socketPath ${serverSocket} >/dev/null 2>&1; do
              sleep 0.5
            done
          '';
        };
      };

      systemd.services.spire-agent = {
        wantedBy = [ "multi-user.target" ];
        after = [ "spire-server.service" ];
        requires = [ "spire-server.service" ];
        path = [
          pkgs.spire
          pkgs.gawk
        ];
        serviceConfig = {
          RuntimeDirectory = "spire-agent";
          StateDirectory = "spire-agent";
          # Join tokens are single-use: never reuse state from a previous
          # attestation.
          ExecStartPre = pkgs.writeShellScript "spire-agent-clean" ''
            ${pkgs.coreutils}/bin/rm -rf /var/lib/spire-agent/* ${agentSocket}
          '';
          Restart = "on-failure";
          RestartSec = 2;
          ExecStart = pkgs.writeShellScript "spire-agent-start" ''
            set -euo pipefail
            token=$(spire-server token generate \
              -spiffeID spiffe://${trustDomain}/agent \
              -socketPath ${serverSocket} | awk '{print $2}')
            exec spire-agent run -config ${spireAgentConf} -joinToken "$token"
          '';
          ExecStartPost = pkgs.writeShellScript "spire-agent-ready" ''
            until ${pkgs.spire}/bin/spire-agent healthcheck -socketPath ${agentSocket} >/dev/null 2>&1; do
              sleep 0.5
            done
          '';
        };
      };

      # Workload entries for uid 0 (keystone and the test runner both run
      # as root). Mirrors `tools/start-spire.sh`.
      systemd.services.spire-entries = {
        wantedBy = [ "multi-user.target" ];
        after = [ "spire-agent.service" ];
        requires = [ "spire-agent.service" ];
        path = [ pkgs.spire ];
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
        };
        script = ''
          mk() {
            spire-server entry create -socketPath ${serverSocket} \
              -parentID spiffe://${trustDomain}/agent \
              -spiffeID "$1" -selector unix:uid:0
          }
          mk spiffe://${trustDomain}/keystone
          for name in redeem foreign obo bearer; do
            mk spiffe://${trustDomain}/service/it-$name/host/h1
          done
        '';
      };

      systemd.services.keystone = {
        wantedBy = [ "multi-user.target" ];
        after = [ "spire-entries.service" ];
        requires = [ "spire-entries.service" ];
        environment = keystoneEnv;
        serviceConfig = {
          TimeoutStartSec = 120;
          ExecStartPre = prepareKeystone;
          ExecStart = "${keystone}/bin/keystone --config ${stateDir}/keystone.conf";
        };
      };

      systemd.services.keystone-bootstrap = {
        wantedBy = [ "multi-user.target" ];
        after = [ "keystone.service" ];
        requires = [ "keystone.service" ];
        environment = keystoneEnv;
        serviceConfig = {
          Type = "oneshot";
          RemainAfterExit = true;
          TimeoutStartSec = 300;
          ExecStart = bootstrap;
        };
      };
    };

  testScript = ''
    machine.start()
    machine.wait_for_unit("keystone-bootstrap.service")
    machine.succeed("curl -sf http://127.0.0.1:8099/health")
    machine.succeed("run-api-tests >&2")
  '';
}
